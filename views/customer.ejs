<!DOCTYPE html>
<html lang="en">
<head>
    <title><%= pageTitle %></title>
    <%- include('partials/head') %>
    <style>
        .landing {
            min-height: 70vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            gap: 24px;
        }

        .landing h1 {
            margin-bottom: 8px;
        }

        .landing-actions {
            display: flex;
            flex-direction: column;
            gap: 12px;
            width: 100%;
            max-width: 320px;
        }

        .landing-actions .primary-button,
        .landing-actions .secondary-button {
            width: 100%;
            padding: 1rem 1.5rem;
            font-size: 1rem;
        }

        .reader {
            position: fixed;
            inset: 0;
            display: flex;
            flex-direction: column;
            background: var(--paper);
            z-index: 10;
        }

        .reader-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 20px;
        }

        .reader-header a {
            font-size: 0.82rem;
            color: var(--muted);
            padding: 8px 12px;
            border: 1px solid var(--line-soft);
            border-radius: 4px;
        }

        .card-stack {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px 20px 24px;
            overflow: hidden;
        }

        .swipe-card {
            width: 100%;
            max-width: 560px;
            max-height: 100%;
            overflow-y: auto;
            background: var(--paper-deep);
            border: 1px solid var(--line-soft);
            border-radius: 8px;
            padding: 36px 28px;
            transition: transform 0.25s ease, opacity 0.25s ease;
            will-change: transform;
            -webkit-overflow-scrolling: touch;
        }

        .swipe-card h2 {
            font-size: clamp(1.4rem, 3vw, 1.8rem);
            margin-bottom: 16px;
        }

        .swipe-card .poem-body {
            font-size: clamp(1rem, 1.6vw, 1.15rem);
            line-height: 1.8;
        }

        .swipe-card.swipe-left {
            transform: translateX(-150%) rotate(-12deg);
            opacity: 0;
        }

        .swipe-card.swipe-right {
            transform: translateX(150%) rotate(12deg);
            opacity: 0;
        }

        .reader-actions {
            display: flex;
            justify-content: center;
            gap: 24px;
            padding: 16px 20px 32px;
        }

        .swipe-btn {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            border: 1px solid var(--line);
            background: var(--paper);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background 0.15s ease, border-color 0.15s ease;
            color: var(--ink);
        }

        .swipe-btn:hover {
            background: var(--paper-deep);
            border-color: var(--muted);
        }

        .swipe-btn svg {
            width: 24px;
            height: 24px;
        }

        .swipe-btn.like-btn:hover {
            border-color: var(--success);
            color: var(--success);
        }

        .swipe-btn.dislike-btn:hover {
            border-color: var(--danger);
            color: var(--danger);
        }

        .end-state {
            min-height: 60vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            gap: 16px;
            padding: 32px;
        }

        .counter {
            font-size: 0.78rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }

        @media (max-width: 760px) {
            .swipe-card {
                padding: 28px 22px;
            }
        }
    </style>
</head>
<body class="page-shell">

<div id="landing" class="landing container" style="max-width: 480px;">
    <p class="eyebrow">Reading room</p>
    <h1>Things to read with your drink</h1>
    <p class="lede">A poem, a story, a line. One at a time.</p>
    <div class="landing-actions">
        <button class="primary-button" id="start-reading">Read something</button>
        <a class="secondary-button" href="/customer/submit">Submit a text</a>
    </div>
</div>

<div id="reader" class="reader" style="display: none;">
    <div class="reader-header">
        <span class="counter" id="counter">1 / <%= texts.length %></span>
        <a href="#" id="close-reader">Close</a>
    </div>
    <div class="card-stack">
        <div class="swipe-card" id="swipe-card"></div>
    </div>
    <div class="reader-actions">
        <button class="swipe-btn dislike-btn" id="dislike-btn" aria-label="Dislike">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <button class="swipe-btn like-btn" id="like-btn" aria-label="Like">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </button>
    </div>
</div>

<div id="end-state" class="end-state container" style="display: none; max-width: 480px;">
    <p class="eyebrow">That's all for now</p>
    <h2>You've seen everything on the table.</h2>
    <p class="lede">Come back later for more.</p>
    <div class="landing-actions">
        <a class="primary-button" href="/customer">Start over</a>
        <a class="secondary-button" href="/customer/submit">Submit a text</a>
    </div>
</div>

<script>
    const texts = <%- JSON.stringify(texts) %>;
    let currentIndex = 0;

    const landing = document.getElementById('landing');
    const reader = document.getElementById('reader');
    const endState = document.getElementById('end-state');
    const swipeCard = document.getElementById('swipe-card');
    const counter = document.getElementById('counter');

    function renderCard() {
        if (currentIndex >= texts.length) {
            reader.style.display = 'none';
            endState.style.display = 'flex';
            return;
        }
        const text = texts[currentIndex];
        const lines = text.content.split('\n').map(line => `<p>${line}</p>`).join('');
        swipeCard.innerHTML = `
            <h2>${text.title}</h2>
            <div class="poem-body">${lines}</div>
            <div class="meta-row" style="margin-top: 24px;">
                <span class="pill">${text.category}</span>
                <span class="tiny">${text.author}</span>
            </div>
        `;
        swipeCard.classList.remove('swipe-left', 'swipe-right');
        counter.textContent = `${currentIndex + 1} / ${texts.length}`;
    }

    function nextCard() {
        currentIndex++;
        renderCard();
    }

    document.getElementById('start-reading').addEventListener('click', () => {
        if (texts.length === 0) return;
        landing.style.display = 'none';
        reader.style.display = 'flex';
        renderCard();
    });

    document.getElementById('close-reader').addEventListener('click', (e) => {
        e.preventDefault();
        reader.style.display = 'none';
        endState.style.display = 'none';
        landing.style.display = 'flex';
    });

    document.getElementById('like-btn').addEventListener('click', () => {
        swipeCard.classList.add('swipe-right');
        setTimeout(nextCard, 250);
    });

    document.getElementById('dislike-btn').addEventListener('click', () => {
        swipeCard.classList.add('swipe-left');
        setTimeout(nextCard, 250);
    });

    // Touch swipe support
    let touchStartX = 0;
    let touchStartY = 0;

    swipeCard.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
    });

    swipeCard.addEventListener('touchend', (e) => {
        const touchEndX = e.changedTouches[0].clientX;
        const touchEndY = e.changedTouches[0].clientY;
        const diffX = touchEndX - touchStartX;
        const diffY = touchEndY - touchStartY;

        if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 60) {
            if (diffX > 0) {
                swipeCard.classList.add('swipe-right');
            } else {
                swipeCard.classList.add('swipe-left');
            }
            setTimeout(nextCard, 250);
        }
    });
</script>
</body>
</html>
