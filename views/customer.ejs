<!DOCTYPE html>
<html lang="en">
<head>
    <title><%= pageTitle %></title>
    <%- include('partials/head') %>
    <style>
        .landing {
            min-height: 70vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            gap: 24px;
        }

        .landing h1 {
            margin-bottom: 8px;
        }

        .landing-actions {
            display: flex;
            flex-direction: column;
            gap: 12px;
            width: 100%;
            max-width: 320px;
        }

        .landing-actions .primary-button,
        .landing-actions .secondary-button {
            width: 100%;
            padding: 1rem 1.5rem;
            font-size: 1rem;
        }

        .reader {
            position: fixed;
            inset: 0;
            display: flex;
            flex-direction: column;
            background: var(--paper);
            z-index: 10;
        }

        .reader-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 20px;
        }

        .reader-header a {
            font-size: 0.82rem;
            color: var(--muted);
            padding: 8px 12px;
            border: 1px solid var(--line-soft);
            border-radius: 4px;
        }

        .card-stack {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px 20px 24px;
            overflow: hidden;
        }

        .swipe-card {
            width: 100%;
            max-width: 560px;
            max-height: 100%;
            overflow-y: auto;
            background: var(--paper-deep);
            border: 1px solid var(--line-soft);
            border-radius: 8px;
            padding: 36px 28px;
            transition: transform 0.25s ease, opacity 0.25s ease;
            will-change: transform;
            -webkit-overflow-scrolling: touch;
            user-select: none;
            cursor: grab;
            position: relative;
        }

        .swipe-card h2 {
            font-size: clamp(1.4rem, 3vw, 1.8rem);
            margin-bottom: 16px;
        }

        .swipe-card .poem-body {
            font-size: clamp(1rem, 1.6vw, 1.15rem);
            line-height: 1.8;
        }

        .swipe-card.swipe-left {
            transform: translateX(-150%) rotate(-12deg);
            opacity: 0;
        }

        .swipe-card.swipe-right {
            transform: translateX(150%) rotate(12deg);
            opacity: 0;
        }

        .vote-overlay {
            position: absolute;
            top: 24px;
            padding: 8px 18px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            font-family: 'Source Sans 3', 'Inter', sans-serif;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.1s ease;
        }

        .vote-overlay-like {
            right: 24px;
            color: var(--success);
            border: 2px solid var(--success);
            transform: rotate(12deg);
        }

        .vote-overlay-dislike {
            left: 24px;
            color: var(--danger);
            border: 2px solid var(--danger);
            transform: rotate(-12deg);
        }

        @keyframes cardEnter {
            from {
                transform: scale(0.85);
                opacity: 0;
            }
            to {
                transform: scale(1);
                opacity: 1;
            }
        }

        .swipe-card.card-enter {
            animation: cardEnter 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        .reader-actions {
            display: flex;
            justify-content: center;
            gap: 24px;
            padding: 16px 20px 32px;
        }

        .swipe-btn {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            border: 1px solid var(--line);
            background: var(--paper);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background 0.15s ease, border-color 0.15s ease;
            color: var(--ink);
        }

        .swipe-btn:hover {
            background: var(--paper-deep);
            border-color: var(--muted);
        }

        .swipe-btn svg {
            width: 24px;
            height: 24px;
        }

        .swipe-btn.like-btn:hover {
            border-color: var(--success);
            color: var(--success);
        }

        .swipe-btn.dislike-btn:hover {
            border-color: var(--danger);
            color: var(--danger);
        }

        .end-state {
            min-height: 60vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            gap: 16px;
            padding: 32px;
        }

        .counter {
            font-size: 0.78rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }

        @media (max-width: 760px) {
            .swipe-card {
                padding: 28px 22px;
            }
        }
    </style>
</head>
<body class="page-shell">

<div id="landing" class="landing container" style="max-width: 480px;">
    <p class="eyebrow">Reading room</p>
    <h1>Things to read with your drink</h1>
    <p class="lede">A poem, a story, a line. One at a time.</p>
    <div class="landing-actions">
        <button class="primary-button" id="start-reading">Read something</button>
        <a class="secondary-button" href="/customer/submit">Submit a text</a>
    </div>
</div>

<div id="reader" class="reader" style="display: none;">
    <div class="reader-header">
        <span class="counter" id="counter">1 / <%= texts.length %></span>
        <a href="#" id="close-reader">Close</a>
    </div>
    <div class="card-stack">
        <div class="swipe-card" id="swipe-card"></div>
    </div>
    <div class="reader-actions">
        <button class="swipe-btn dislike-btn" id="dislike-btn" aria-label="Dislike">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <button class="swipe-btn like-btn" id="like-btn" aria-label="Like">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </button>
    </div>
</div>

<div id="end-state" class="end-state container" style="display: none; max-width: 480px;">
    <p class="eyebrow">That's all for now</p>
    <h2>You've seen everything on the table.</h2>
    <p class="lede">Come back later for more.</p>
    <div class="landing-actions">
        <a class="primary-button" href="/customer">Start over</a>
        <a class="secondary-button" href="/customer/submit">Submit a text</a>
    </div>
</div>

<script>
    const texts = <%- JSON.stringify(texts) %>;
    let currentIndex = 0;
    const sessionId = (typeof crypto !== 'undefined' && crypto.randomUUID)
        ? crypto.randomUUID()
        : `session-${Date.now()}-${Math.random().toString(16).slice(2)}`;
    let isTransitioning = false;

    const landing = document.getElementById('landing');
    const reader = document.getElementById('reader');
    const endState = document.getElementById('end-state');
    const swipeCard = document.getElementById('swipe-card');
    const counter = document.getElementById('counter');
    const overlayState = { like: null, dislike: null };

    function updateVoteOverlay(deltaX) {
        const likeOverlay = overlayState.like;
        const dislikeOverlay = overlayState.dislike;
        if (!likeOverlay || !dislikeOverlay) return;

        const absDelta = Math.abs(deltaX);
        const opacity = Math.min(absDelta / 140, 1);

        if (deltaX > 0) {
            likeOverlay.style.opacity = opacity;
            dislikeOverlay.style.opacity = 0;
        } else if (deltaX < 0) {
            likeOverlay.style.opacity = 0;
            dislikeOverlay.style.opacity = opacity;
        } else {
            likeOverlay.style.opacity = 0;
            dislikeOverlay.style.opacity = 0;
        }
    }

    function resetVoteOverlay() {
        const likeOverlay = overlayState.like;
        const dislikeOverlay = overlayState.dislike;
        if (likeOverlay) likeOverlay.style.opacity = 0;
        if (dislikeOverlay) dislikeOverlay.style.opacity = 0;
    }

    function escapeHtml(str) {
        return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    async function recordEvent(endpoint, payload) {
        try {
            await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
        } catch (err) {
            console.error(`Failed to record ${endpoint}:`, err);
        }
    }

    function recordVote(textId, vote) {
        recordEvent('/api/votes', { textId, vote, sessionId });
    }

    function renderCard() {
        if (currentIndex >= texts.length) {
            reader.style.display = 'none';
            endState.style.display = 'flex';
            swipeCard.style.transition = '';
            return;
        }
        const text = texts[currentIndex];
        const lines = escapeHtml(text.content).split('\n').map(line => `<p>${line}</p>`).join('');
        swipeCard.innerHTML = `
            <h2>${text.title}</h2>
            <div class="poem-body">${lines}</div>
            <div class="meta-row" style="margin-top: 24px;">
                <span class="pill">${text.category}</span>
                <span class="tiny">${text.author}</span>
            </div>
            <div class="vote-overlay vote-overlay-like" id="vote-overlay-like">Like</div>
            <div class="vote-overlay vote-overlay-dislike" id="vote-overlay-dislike">Dislike</div>
        `;
        const newLikeOverlay = document.getElementById('vote-overlay-like');
        const newDislikeOverlay = document.getElementById('vote-overlay-dislike');
        overlayState.like = newLikeOverlay;
        overlayState.dislike = newDislikeOverlay;
        swipeCard.classList.remove('swipe-left', 'swipe-right', 'card-enter');
        swipeCard.style.transition = 'none';
        swipeCard.style.transform = '';
        swipeCard.style.opacity = '';
        void swipeCard.offsetWidth;
        swipeCard.classList.add('card-enter');
        counter.textContent = `${currentIndex + 1} / ${texts.length}`;
        recordEvent('/api/displays', { textId: text.id, sessionId });
    }

    function nextCard() {
        currentIndex++;
        renderCard();
    }

    function swipeCardTo(direction) {
        if (isTransitioning) return;
        isTransitioning = true;
        swipeCard.classList.add(direction);
        swipeCard.style.transform = '';
        swipeCard.style.opacity = '0';
        if (currentIndex < texts.length) {
            const vote = direction === 'swipe-right' ? 'like' : 'dislike';
            recordVote(texts[currentIndex].id, vote);
        }
        setTimeout(() => {
            nextCard();
            isTransitioning = false;
        }, 250);
    }

    document.getElementById('start-reading').addEventListener('click', () => {
        if (texts.length === 0) return;
        recordEvent('/api/sessions', { sessionId });
        landing.style.display = 'none';
        reader.style.display = 'flex';
        renderCard();
    });

    document.getElementById('close-reader').addEventListener('click', (e) => {
        e.preventDefault();
        reader.style.display = 'none';
        endState.style.display = 'none';
        landing.style.display = 'flex';
    });

    document.getElementById('like-btn').addEventListener('click', () => {
        swipeCardTo('swipe-right');
    });

    document.getElementById('dislike-btn').addEventListener('click', () => {
        swipeCardTo('swipe-left');
    });

    swipeCard.addEventListener('animationend', (e) => {
        if (e.animationName === 'cardEnter') {
            swipeCard.classList.remove('card-enter');
            swipeCard.style.transition = '';
        }
    });

    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let currentDeltaX = 0;
    let hasMoved = false;

    function handleDragStart(e) {
        isDragging = true;
        hasMoved = false;
        const point = e.touches ? e.touches[0] : e;
        startX = point.clientX;
        startY = point.clientY;
        currentDeltaX = 0;
        swipeCard.style.transition = 'none';
    }

    function handleDragMove(e) {
        if (!isDragging) return;
        const point = e.touches ? e.touches[0] : e;
        const deltaX = point.clientX - startX;
        const deltaY = point.clientY - startY;

        if (!hasMoved) {
            if (Math.abs(deltaY) > Math.abs(deltaX) && Math.abs(deltaY) > 10) {
                isDragging = false;
                swipeCard.style.transition = '';
                swipeCard.style.transform = '';
                resetVoteOverlay();
                return;
            }
            if (Math.abs(deltaX) > 5) {
                hasMoved = true;
            }
        }

        if (e.cancelable) e.preventDefault();
        currentDeltaX = deltaX;
        const rotation = deltaX * 0.04;
        swipeCard.style.transform = `translateX(${deltaX}px) rotate(${rotation}deg)`;
        updateVoteOverlay(deltaX);
    }

    function handleDragEnd() {
        if (!isDragging) return;
        if (isTransitioning) return;
        isDragging = false;
        swipeCard.style.transition = 'transform 0.25s ease, opacity 0.25s ease';

        if (Math.abs(currentDeltaX) > 80) {
            isTransitioning = true;
            const direction = currentDeltaX > 0 ? 'swipe-right' : 'swipe-left';
            swipeCard.classList.add(direction);
            swipeCard.style.transform = '';
            swipeCard.style.opacity = '0';
            if (currentIndex < texts.length) {
                const vote = direction === 'swipe-right' ? 'like' : 'dislike';
                recordVote(texts[currentIndex].id, vote);
            }
            setTimeout(() => {
                nextCard();
                isTransitioning = false;
            }, 250);
        } else {
            swipeCard.style.transform = '';
            swipeCard.style.opacity = '';
            resetVoteOverlay();
        }
        currentDeltaX = 0;
    }

    swipeCard.addEventListener('mousedown', handleDragStart);
    document.addEventListener('mousemove', handleDragMove);
    document.addEventListener('mouseup', handleDragEnd);

    swipeCard.addEventListener('touchstart', handleDragStart, { passive: true });
    swipeCard.addEventListener('touchmove', handleDragMove, { passive: false });
    swipeCard.addEventListener('touchend', handleDragEnd);
</script>
</body>
</html>
