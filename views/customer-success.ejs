<!DOCTYPE html>
<html lang="en">
<head>
    <title><%= pageTitle %></title>
    <%- include('partials/head') %>
</head>
<body class="page-shell">
    <div class="container" style="max-width: 560px;">
        <main class="card" style="text-align: center; padding: 48px 32px;">
            <p class="eyebrow">Thank you</p>
            <h1 style="margin: 12px 0 16px;">Your words have been left on the table.</h1>
            <p class="lede">A curator will read it soon. If it feels right, it will appear in the reading room.</p>
            <div class="actions" style="align-items: center;">
                <a class="primary-button" href="/customer">Return to the reading room</a>
            </div>
        </main>
    </div>
</body>
</html>
