<!DOCTYPE html>
<html lang="en">
<head>
    <title><%= pageTitle %></title>
    <%- include('partials/head') %>
</head>
<body class="page-shell">
    <div class="container container--wide">
        <header class="topbar">
            <div class="topbar-left">
                <p class="eyebrow">Editor's desk</p>
                <h1>Curator</h1>
            </div>
            <div class="topbar-right">
                <a class="admin-link" href="/">Home</a>
                <a class="secondary-button" href="/curator/submissions">All submissions</a>
            </div>
        </header>

        <div class="stats-row">
            <div class="stat-item">
                <span class="stat-label">Pending</span>
                <span class="stat-value"><%= stats.pending %></span>
            </div>
            <div class="stat-item">
                <span class="stat-label">Approved</span>
                <span class="stat-value"><%= stats.approved %></span>
            </div>
            <div class="stat-item">
                <span class="stat-label">Rejected</span>
                <span class="stat-value"><%= stats.rejected %></span>
            </div>
            <div class="stat-item">
                <span class="stat-label">Total</span>
                <span class="stat-value"><%= stats.total %></span>
            </div>
        </div>

        <section class="card">
            <h2>Needs attention</h2>
            <% if (submissions.length === 0) { %>
                <p class="empty-state">Nothing to review right now.</p>
            <% } else { %>
                <table class="submission-table" style="margin-top: 16px;">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% submissions.forEach((submission) => { %>
                            <tr>
                                <td><%= submission.title %></td>
                                <td><%= submission.author %></td>
                                <td><%= submission.category %></td>
                                <td><span class="status-badge status-<%= submission.status %>"><%= submission.status %></span></td>
                                <td><%= new Date(submission.created_at).toLocaleDateString() %></td>
                                <td><a href="/curator/submissions/<%= submission.id %>">Open</a></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </section>
    </div>
</body>
</html>
