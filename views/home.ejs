<!DOCTYPE html>
<html lang="en">
<head>
    <title>Café Writing</title>
    <%- include('partials/head') %>
</head>
<body class="page-shell">
    <div class="container">
        <header style="margin-bottom: 48px;">
            <p class="eyebrow">A quiet place</p>
            <h1>Café Writing</h1>
        </header>

        <main>
            <p class="lede" style="margin-bottom: 32px;">A small corner for reading and leaving words behind.</p>

            <div class="home-links">
                <a href="/customer">
                    <span>Read</span>
                    <span>Browse the pieces on the table</span>
                </a>
                <a href="/customer/submit">
                    <span>Submit</span>
                    <span>Leave something for the next person</span>
                </a>
            </div>

            <div style="margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--line-soft); display: flex; gap: 10px; flex-wrap: wrap;">
                <a class="admin-link" href="/curator">Curator</a>
                <a class="admin-link" href="/barista">Barista</a>
                <a class="admin-link" href="/qr">QR</a>
            </div>
        </main>
    </div>
</body>
</html>
